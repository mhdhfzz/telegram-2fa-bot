# Telegram 2FA Bot Configuration
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
DB_PATH=2fa_bot.db
LOG_LEVEL=INFO
PIN_LENGTH=6
AUTO_DELETE_SECONDS=90

# Telegram Mini App Configuration
MINI_APP_ENABLED=true
MINI_APP_HOST=0.0.0.0
MINI_APP_PORT=8080
# URL HTTPS Mini App yang didaftarkan di BotFather (misal: https://bot.example.com atau URL tunnel)
MINI_APP_URL=

# Administrator Telegram User IDs (pisahkan dengan koma jika lebih dari satu)
# Dapatkan ID Telegram Anda melalui bot @userinfobot di Telegram
ADMIN_USER_IDS=12345678,87654321

# Pemeliharaan & Optimasi Sumber Daya (VPS 1 Core 1GB RAM)
# Batas retensi audit log (hari) sebelum dihapus otomatis
LOG_RETENTION_DAYS=30
# Interval eksekusi maintenance otomatis (jam)
MAINTENANCE_INTERVAL_HOURS=6

